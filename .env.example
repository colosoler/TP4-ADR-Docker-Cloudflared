# Copiá este archivo a .env y cambiá las claves. El .env NUNCA se commitea.

# Usuario administrador de Postgres: solo lo usan los scripts de db/init
POSTGRES_DB=concesionaria
POSTGRES_USER=concesionaria_admin
POSTGRES_PASSWORD=cambiar_esta_clave_admin

# Usuario con permisos mínimos que usa el backend (lo crea db/init/00_roles.sh)
APP_DB_USER=concesionaria_app
APP_DB_PASSWORD=cambiar_esta_clave_app
